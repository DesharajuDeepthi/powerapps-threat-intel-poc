SLACK_BOT_TOKEN=
SLACK_CHANNEL_NAME=feedly-threat-intel

DOWNLOAD_DIR=/app/downloads
OUTPUT_FILE=/app/output/Threat_Intelligence_Findings.xlsx
PROCESSED_FILES_PATH=/app/data/processed_files.json
LOG_DIR=/app/logs
ANALYSIS_RESULTS_DIR=/app/data/results
LOCAL_REPOSITORY_DIR=/app/data/local_repository
SQLITE_DB_PATH=/app/data/threat_intel.db
